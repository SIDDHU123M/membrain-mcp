{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-09-29/server.schema.json",
  "name": "io.github.SIDDHU123M/membrain",
  "description": "Self-hosted memory ledger you and your agents share. One SQLite file, hybrid recall, web UI to review everything. Works offline.",
  "repository": {
    "url": "https://github.com/SIDDHU123M/membrain-mcp",
    "source": "github"
  },
  "websiteUrl": "https://membrain.devlune.in",
  "version": "0.1.16",
  "packages": [
    {
      "registryType": "npm",
      "registryBaseUrl": "https://registry.npmjs.org",
      "identifier": "membrain-mcp",
      "version": "0.1.16",
      "runtimeHint": "npx",
      "transport": { "type": "stdio" },
      "packageArguments": [
        {
          "type": "positional",
          "value": "--stdio",
          "description": "Run the MCP server over stdio"
        }
      ]
    }
  ]
}
