{
  "name": "membrain-mcp",
  "version": "0.1.9",
  "description": "Self-hosted AI memory ledger. You and your agents share one memory store over MCP — one SQLite file, web UI, REST, works offline.",
  "keywords": [
    "mcp",
    "model-context-protocol",
    "memory",
    "ai-agents",
    "self-hosted",
    "sqlite",
    "ollama",
    "local-first"
  ],
  "type": "module",
  "license": "UNLICENSED",
  "bin": {
    "membrain": "dist/server/index.js"
  },
  "files": [
    "dist"
  ],
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx src/server/index.ts",
    "build": "tsc -p tsconfig.build.json && vite build",
    "start": "node dist/server/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run test && npm run build",
    "prepack": "node scripts/swap-readme.mjs npm",
    "postpack": "node scripts/swap-readme.mjs restore",
    "export:landing": "npm run build && node scripts/export-landing.mjs",
    "deploy:landing": "npm run export:landing && wrangler pages deploy --branch main",
    "stage:landing": "npm run export:landing && wrangler pages deploy --branch staging"
  },
  "dependencies": {
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^8.0.0",
    "@modelcontextprotocol/sdk": "^1.12.0",
    "better-sqlite3": "^11.10.0",
    "fastembed": "^1.14.4",
    "fastify": "^5.3.0",
    "pdf-parse": "^1.1.1",
    "sqlite-vec": "^0.1.7-alpha.2",
    "zod": "^3.24.0"
  },
  "devDependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@tailwindcss/vite": "^4.1.0",
    "@types/better-sqlite3": "^7.6.12",
    "@types/d3-force": "^3.0.10",
    "@types/node": "^22.15.0",
    "@types/react": "^19.1.0",
    "@types/react-dom": "^19.1.0",
    "@vitejs/plugin-react": "^4.4.0",
    "d3-force": "^3.0.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "tailwindcss": "^4.1.0",
    "tsx": "^4.19.0",
    "typescript": "^5.8.0",
    "vite": "^6.3.0",
    "vitest": "^3.1.0"
  }
}
